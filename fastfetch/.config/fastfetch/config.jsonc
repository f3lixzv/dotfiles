{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "type": "auto",
        "padding": {
            "top": 2
        },
        "color": {
            "1": "white",
            "2": "white"
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m"
        },
        "break",
        {
            "type": "title",
            "keyWidth": 10,
            "color": {
                "user": "white",
                "at": "bright_black",
                "host": "white"
            }
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "white"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "white"
        },
        {
            "type": "player",
            "key": " ",
            "keyColor": "white"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m  \u001b[90m  \u001b[37m"
        },
        "break",
        "break"
    ]
}
