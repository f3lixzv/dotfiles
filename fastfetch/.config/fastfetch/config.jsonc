{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "white",
            "2": "white"
        },
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        }
    },
    "display": {
        "color": {
            "keys": "white",
            "title": "white",
            "output": "white"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[97m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "white"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "white"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "white"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[97m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[97m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "white"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "white"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "white"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[97m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[97m┌──────────────────────Desktop───────────────────────┐"
        },
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "white"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "white"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[97m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[97m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "white",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "white"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[97m└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
